      "Edit(./public/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.env.example)",
      "Write(./.env.example)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npx tsc:*)",
