      "Read(./tests/**)",
      "Read(./public/**)",
      "Read(./package.json)",
      "Read(./tsconfig.json)",
      "Read(./next.config.ts)",
      "Read(./eslint.config.mjs)",
      "Read(./.env.example)",
      "Read(./CLAUDE.md)",
      "Edit(./src/**)",
