# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# données personnelles et sauvegardes (CLAUDE.md, section 8.4)
/data/
/backups/

# photos publiques gérées par l'admin (réalisations, couverture d'article) : spécifiques à
# l'instance en production, pas versionnées — à inclure dans la sauvegarde du VPS comme /data/.
/public/uploads/

# clés et certificats
*.key
*.p12
*credentials*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
